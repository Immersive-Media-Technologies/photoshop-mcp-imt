{
  "id": "llc.imt.ps-mcp-bridge",
  "name": "Photoshop-MCP-IMT Bridge",
  "version": "1.2.1",
  "manifestVersion": 5,
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": true
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "bridgePanel",
      "label": {
        "default": "Photoshop-MCP-IMT Bridge"
      },
      "minimumSize": {
        "width": 240,
        "height": 120
      },
      "maximumSize": {
        "width": 400,
        "height": 200
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 140
      }
    }
  ]
}
